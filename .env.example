# Required for Prisma and database-backed marketplace features
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for NextAuth in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: EmailJS contact form
NEXT_PUBLIC_SERVICE_ID=""
NEXT_PUBLIC_TEMPLATE_ID=""
NEXT_PUBLIC_PUBLIC_ID=""

# Optional: Pinata image uploads
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""

# Optional: ImageKit image uploads (server-side only)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Optional: ImgBB image uploads (server-side only)
IMGBB_API_KEY=""

# Optional: Imgur image uploads (server-side only)
IMGUR_CLIENT_ID=""

# Shared, durable API rate limiting (Upstash Redis REST)
# Required in production for registration and image uploads; leave blank for local development.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set true only when the deployment proxy strips client-supplied forwarding headers and writes its own.
TRUST_PROXY_HEADERS="false"
