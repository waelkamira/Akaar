# Required for Prisma and database-backed marketplace features
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for NextAuth in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: EmailJS contact form
NEXT_PUBLIC_SERVICE_ID=""
NEXT_PUBLIC_TEMPLATE_ID=""
NEXT_PUBLIC_PUBLIC_ID=""

# Optional: Pinata image uploads
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""

# Optional: ImageKit image uploads (server-side only)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Optional: ImgBB image uploads (server-side only)
IMGBB_API_KEY=""

# Optional: Imgur image uploads (server-side only)
IMGUR_CLIENT_ID=""

# Required in production for shared API rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
