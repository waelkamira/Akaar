generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================================
// 01. ENUMS
// ============================================================
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  COMPLETED
}

enum VendorOrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  ADJUSTMENT
  PAYOUT
  FEE
  TAX
  CHARGEBACK
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  UNAVAILABLE
}

enum PropertyType {
  APARTMENT
  VILLA
  LAND
  COMMERCIAL
  OFFICE
  OTHER
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum DocumentType {
  IDENTITY
  PASSPORT
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  BANK_STATEMENT
  ADDRESS_PROOF
  OTHER
}

enum TaxType {
  VAT
  GST
  SALES_TAX
  WITHHOLDING
  CUSTOMS
  OTHER
}

// ============================================================
// 02. IDENTITY & ACCESS CONTROL
// ============================================================
model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  userName            String?                  @unique @db.VarChar(100)
  passwordHash        String?
  imageUrl            String?
  phone               String?
  status              UserStatus               @default(ACTIVE)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  seller              Seller?
  addresses           UserAddress[]
  sessions            UserSession[]
  accounts            OAuthAccount[]
  roles               UserRoleAssignment[]
  twoFactor           TwoFactorAuthentication?
  passwordResets      PasswordResetToken[]
  consents            UserConsent[]
  orders              Order[]
  cart                Cart?
  reviews             Review[]
  favorites           Favorite[]
  notifications       Notification[]
  tickets             SupportTicket[]
  reports             Report[]
  auditLogs           AuditLog[]
  conversations       StoreConversation[]      @relation("CustomerConversations")
  messages            StoreMessage[]           @relation("MessageSender")
  supportMessages     SupportMessage[]
  disputes            Dispute[]
  productQuestions    ProductQuestion[]
  productAnswers      ProductAnswer[]
  storeReviews        StoreReview[]
  recommendations     Recommendation[]
  couponRedemptions   CouponRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  propertyWishlist    PropertyWishlist[]
  bookingRequests     BookingRequest[]
  ownedProperties     Property[]               @relation("PropertyOwner")
  staffMemberships    SellerStaff[]
  payoutMethods       PayoutMethod[]

  @@index([status, createdAt])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model OAuthAccount {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  permissions RolePermission[]
  assignments UserRoleAssignment[]
  sellerStaff SellerStaff[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  scopeType String   @default("PLATFORM")
  scopeId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("user_role_assignments")
}

model TwoFactorAuthentication {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  secret      String
  enabled     Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_authentication")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([identifier, expiresAt])
  @@map("verification_tokens")
}

model UserConsent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  consentType String
  version     String
  accepted    Boolean
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("user_consents")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ipAddress String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ============================================================
// 03. GLOBALIZATION
// ============================================================
model Currency {
  code             String            @id @db.VarChar(3)
  name             String
  symbol           String?
  minorUnits       Int               @default(2)
  isActive         Boolean           @default(true)
  baseRates        ExchangeRate[]    @relation("RateBase")
  quoteRates       ExchangeRate[]    @relation("RateQuote")
  countries        Country[]
  productPrices    ProductPrice[]
  supplierProducts SupplierProduct[]
  orders           Order[]
  payments         Payment[]
  refunds          Refund[]
  shippingRates    ShippingRate[]

  @@map("currencies")
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @db.VarChar(3)
  quoteCurrency String   @db.VarChar(3)
  rate          Decimal  @db.Decimal(24, 12)
  source        String?
  effectiveAt   DateTime
  createdAt     DateTime @default(now())
  base          Currency @relation("RateBase", fields: [baseCurrency], references: [code])
  quote         Currency @relation("RateQuote", fields: [quoteCurrency], references: [code])

  @@index([baseCurrency, quoteCurrency, effectiveAt])
  @@map("exchange_rates")
}

model Country {
  code                String                  @id @db.VarChar(2)
  name                String
  phoneCode           String?
  currencyCode        String?                 @db.VarChar(3)
  isActive            Boolean                 @default(true)
  currency            Currency?               @relation(fields: [currencyCode], references: [code])
  regions             StateProvince[]
  cities              City[]
  taxRegions          TaxRegion[]
  warehouses          Warehouse[]
  sellerRegistrations SellerTaxRegistration[]

  @@map("countries")
}

model StateProvince {
  id          String  @id @default(uuid()) @db.Uuid
  countryCode String  @db.VarChar(2)
  name        String
  code        String?
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  cities      City[]

  @@unique([countryCode, name])
  @@map("state_provinces")
}

model City {
  id          String         @id @default(uuid()) @db.Uuid
  countryCode String         @db.VarChar(2)
  stateId     String?        @db.Uuid
  name        String
  country     Country        @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  state       StateProvince? @relation(fields: [stateId], references: [id], onDelete: SetNull)

  @@index([countryCode, name])
  @@map("cities")
}

// ============================================================
// 04. USERS & ADDRESSES
// ============================================================
model UserAddress {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        AddressType @default(SHIPPING)
  fullName    String
  phone       String
  countryCode String      @db.VarChar(2)
  state       String?
  city        String
  postalCode  String?
  address1    String
  address2    String?
  latitude    Decimal?    @db.Decimal(10, 7)
  longitude   Decimal?    @db.Decimal(10, 7)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("user_addresses")
}

// ============================================================
// 05. SELLERS, KYC & STORES
// ============================================================
model Seller {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @db.Uuid
  displayName        String
  legalName          String?
  slug               String                  @unique
  sellerType         String                  @default("INDIVIDUAL")
  description        String?                 @db.Text
  status             SellerStatus            @default(PENDING)
  isVerified         Boolean                 @default(false)
  countryCode        String?                 @db.VarChar(2)
  registrationNumber String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  stores             Store[]
  verifications      SellerVerification[]
  documents          SellerDocument[]
  taxRegistrations   SellerTaxRegistration[]
  staff              SellerStaff[]
  warehouses         Warehouse[]
  vendorOrders       VendorOrder[]
  ledger             SellerLedgerEntry[]
  payouts            Payout[]
  payoutMethods      PayoutMethod[]
  reviews            StoreReview[]
  conversations      StoreConversation[]
  commissions        CommissionTransaction[]
  promotionLinks     PromotionSeller[]

  @@index([status, createdAt])
  @@index([countryCode, status])
  @@map("sellers")
}

model SellerVerification {
  id          String             @id @default(uuid()) @db.Uuid
  sellerId    String             @db.Uuid
  status      VerificationStatus @default(PENDING)
  reviewerId  String?            @db.Uuid
  notes       String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  seller      Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documents   SellerDocument[]

  @@index([sellerId, status])
  @@map("seller_verifications")
}

model SellerDocument {
  id             String              @id @default(uuid()) @db.Uuid
  sellerId       String              @db.Uuid
  verificationId String?             @db.Uuid
  type           DocumentType
  storageKey     String
  checksum       String?
  status         VerificationStatus  @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  seller         Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  verification   SellerVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([sellerId, type])
  @@map("seller_documents")
}

model SellerTaxRegistration {
  id          String    @id @default(uuid()) @db.Uuid
  sellerId    String    @db.Uuid
  countryCode String    @db.VarChar(2)
  taxType     TaxType
  taxNumber   String
  isVerified  Boolean   @default(false)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  country     Country   @relation(fields: [countryCode], references: [code])

  @@unique([sellerId, countryCode, taxType, taxNumber])
  @@map("seller_tax_registrations")
}

model Store {
  id              String             @id @default(uuid()) @db.Uuid
  sellerId        String             @db.Uuid
  name            String
  slug            String             @unique
  description     String?            @db.Text
  logoUrl         String?
  defaultLanguage String             @default("en")
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  seller          Seller             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  products        Product[]
  translations    StoreTranslation[]
  properties      Property[]

  @@index([sellerId, isActive])
  @@map("stores")
}

model StoreTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  language    String
  name        String
  description String?
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, language])
  @@map("store_translations")
}

model SellerStaff {
  id         String    @id @default(uuid()) @db.Uuid
  sellerId   String    @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([sellerId, userId])
  @@map("seller_staff")
}

// ============================================================
// 06. CATALOG & PRODUCT ATTRIBUTES
// ============================================================
model Category {
  id             String                @id @default(uuid()) @db.Uuid
  parentId       String?               @db.Uuid
  name           String
  slug           String                @unique
  description    String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  parent         Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]            @relation("CategoryTree")
  products       ProductCategory[]
  translations   CategoryTranslation[]
  promotionLinks PromotionCategory[]

  @@index([parentId, isActive])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  language    String
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@map("category_translations")
}

model Brand {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  slug         String             @unique
  description  String?
  logoUrl      String?
  products     Product[]
  translations BrandTranslation[]

  @@map("brands")
}

model BrandTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  brandId     String  @db.Uuid
  language    String
  name        String
  description String?
  brand       Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, language])
  @@map("brand_translations")
}

model Product {
  id              String               @id @default(uuid()) @db.Uuid
  storeId         String               @db.Uuid
  brandId         String?              @db.Uuid
  title           String               @db.VarChar(300)
  slug            String
  description     String?              @db.Text
  status          ProductStatus        @default(DRAFT)
  isActive        Boolean              @default(true)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brand           Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories      ProductCategory[]
  variants        ProductVariant[]
  media           ProductMedia[]
  translations    ProductTranslation[]
  attributes      ProductAttribute[]
  identifiers     ProductIdentifier[]
  reviews         Review[]
  favorites       Favorite[]
  recommendations Recommendation[]
  questions       ProductQuestion[]
  promotionLinks  PromotionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([brandId])
  @@index([status, isActive, createdAt])
  @@map("products")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @db.Uuid
  language    String
  title       String
  description String? @db.Text
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@map("product_translations")
}

model ProductMedia {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  storageKey String
  mediaType  String   @default("IMAGE")
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model AttributeDefinition {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String
  code              String                  @unique
  dataType          String
  isVariant         Boolean                 @default(false)
  isFilterable      Boolean                 @default(false)
  values            ProductAttributeValue[]
  variants          VariantAttribute[]
  translations      AttributeTranslation[]
  productAttributes ProductAttribute[]

  @@map("attribute_definitions")
}

model AttributeTranslation {
  id          String              @id @default(uuid()) @db.Uuid
  attributeId String              @db.Uuid
  language    String
  name        String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, language])
  @@map("attribute_translations")
}

model ProductAttribute {
  id          String              @id @default(uuid()) @db.Uuid
  productId   String              @db.Uuid
  attributeId String              @db.Uuid
  value       String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String              @id @default(uuid()) @db.Uuid
  attributeId String              @db.Uuid
  value       String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttribute[]

  @@unique([attributeId, value])
  @@map("product_attribute_values")
}

model ProductVariant {
  id              String                 @id @default(uuid()) @db.Uuid
  productId       String                 @db.Uuid
  sku             String                 @unique
  barcode         String?
  title           String?
  status          VariantStatus          @default(ACTIVE)
  weight          Decimal?               @db.Decimal(12, 3)
  weightUnit      String?
  dimensions      Json?
  hsCode          String?
  countryOfOrigin String?                @db.VarChar(2)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  product         Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices          ProductPrice[]
  inventory       Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  movements       InventoryMovement[]
  reservations    InventoryReservation[]
  attributes      VariantAttribute[]
  supplierLinks   SupplierProduct[]
  purchaseItems   PurchaseOrderItem[]
  transferItems   StockTransferItem[]

  @@index([productId, status])
  @@map("product_variants")
}

model VariantAttribute {
  variantId   String                @db.Uuid
  attributeId String                @db.Uuid
  valueId     String                @db.Uuid
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition   @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  value       ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@map("variant_attributes")
}

model ProductIdentifier {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  type      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([productId])
  @@map("product_identifiers")
}

model ProductPrice {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid
  currency    String         @db.VarChar(3)
  amount      Decimal        @db.Decimal(19, 4)
  compareAt   Decimal?       @db.Decimal(19, 4)
  validFrom   DateTime       @default(now())
  validUntil  DateTime?
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currencyRef Currency       @relation(fields: [currency], references: [code])

  @@unique([variantId, currency, validFrom])
  @@index([variantId, currency, validFrom])
  @@map("product_prices")
}

// ============================================================
// 07. INVENTORY & WAREHOUSES
// ============================================================
model Warehouse {
  id                String                 @id @default(uuid()) @db.Uuid
  sellerId          String?                @db.Uuid
  name              String
  code              String
  countryCode       String                 @db.VarChar(2)
  city              String?
  address           String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  seller            Seller?                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  country           Country                @relation(fields: [countryCode], references: [code])
  inventory         Inventory[]
  movements         InventoryMovement[]
  reservations      InventoryReservation[]
  purchaseOrders    PurchaseOrder[]
  outgoingTransfers StockTransfer[]        @relation("TransferSource")
  incomingTransfers StockTransfer[]        @relation("TransferTarget")

  @@unique([sellerId, code])
  @@index([countryCode, city])
  @@map("warehouses")
}

model Inventory {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid
  warehouseId String         @db.Uuid
  onHand      Int            @default(0)
  reserved    Int            @default(0)
  updatedAt   DateTime       @updatedAt
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  variantId      String                @db.Uuid
  warehouseId    String                @db.Uuid
  type           InventoryMovementType
  quantity       Int
  referenceType  String?
  referenceId    String?
  idempotencyKey String?               @unique
  note           String?
  createdAt      DateTime              @default(now())
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  variantId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  orderItemId    String            @db.Uuid
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime          @default(now())
  idempotencyKey String?           @unique
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderItem      OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([expiresAt, status])
  @@index([orderItemId])
  @@index([variantId, warehouseId, status])
  @@map("inventory_reservations")
}

model StockTransfer {
  id                String              @id @default(uuid()) @db.Uuid
  sourceWarehouseId String              @db.Uuid
  targetWarehouseId String              @db.Uuid
  status            String              @default("PENDING")
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  items             StockTransferItem[]
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse   Warehouse           @relation("TransferTarget", fields: [targetWarehouseId], references: [id], onDelete: Restrict)

  @@index([sourceWarehouseId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String         @id @default(uuid()) @db.Uuid
  transferId String         @db.Uuid
  variantId  String         @db.Uuid
  quantity   Int
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@map("stock_transfer_items")
}

// ============================================================
// 08. SUPPLIERS & PROCUREMENT
// ============================================================
model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  email          String?
  phone          String?
  countryCode    String?           @db.VarChar(2)
  address        String?
  createdAt      DateTime          @default(now())
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model SupplierProduct {
  id           String         @id @default(uuid()) @db.Uuid
  supplierId   String         @db.Uuid
  variantId    String         @db.Uuid
  supplierSku  String?
  cost         Decimal        @db.Decimal(19, 4)
  currency     String         @db.VarChar(3)
  leadTimeDays Int?
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  currencyRef  Currency       @relation(fields: [currency], references: [code])

  @@unique([supplierId, variantId])
  @@map("supplier_products")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  supplierId  String              @db.Uuid
  warehouseId String              @db.Uuid
  orderNumber String              @unique
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @db.VarChar(3)
  totalAmount Decimal             @db.Decimal(19, 4)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  purchaseOrderId   String             @db.Uuid
  variantId         String             @db.Uuid
  quantityOrdered   Int
  quantityReceived  Int                @default(0)
  unitCost          Decimal            @db.Decimal(19, 4)
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@index([variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  purchaseOrderId String             @db.Uuid
  reference       String?
  receivedAt      DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String            @id @default(uuid()) @db.Uuid
  receiptId      String            @db.Uuid
  purchaseItemId String            @db.Uuid
  quantity       Int
  receipt        GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseOrderItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_items")
}

// ============================================================
// 09. CART & GUEST CHECKOUT
// ============================================================
model GuestSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  cart      Cart?
  orders    Order[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

