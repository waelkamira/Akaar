  phone       String
  countryCode String      @db.VarChar(2)
  state       String?
  city        String
  postalCode  String?
  address1    String
  address2    String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

