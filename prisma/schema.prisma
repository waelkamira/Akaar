  orderNumber      String                @unique
  userId           String?               @db.Uuid
  guestSessionId   String?               @db.Uuid
  guestEmail       String?
  guestPhone       String?
  status           OrderStatus           @default(PENDING)
  currency         String                @db.VarChar(3)
  subtotal         Decimal               @db.Decimal(19, 4)
  discountTotal    Decimal               @default(0) @db.Decimal(19, 4)
  taxTotal         Decimal               @default(0) @db.Decimal(19, 4)
  shippingTotal    Decimal               @default(0) @db.Decimal(19, 4)
  grandTotal       Decimal               @db.Decimal(19, 4)
  exchangeRate     Decimal?              @db.Decimal(24, 12)
  exchangeSource   String?
  idempotencyKey   String?               @unique
  placedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
