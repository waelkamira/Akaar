// ============================================================
// 11. PAYMENTS, REFUNDS & PROVIDERS
// ============================================================
model PaymentProvider {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  settings  Json?
  createdAt DateTime  @default(now())
  payments  Payment[]

  @@map("payment_providers")
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @db.Uuid
  amount            Decimal          @db.Decimal(19, 4)
  currency          String           @db.VarChar(3)
  status            PaymentStatus    @default(PENDING)
  provider          String
  providerReference String?          @unique
  idempotencyKey    String?          @unique
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currencyRef       Currency         @relation(fields: [currency], references: [code])
  providerRef       PaymentProvider  @relation(fields: [provider], references: [code], onDelete: Restrict)
  attempts          PaymentAttempt[]
  refunds           Refund[]
  disputes          Dispute[]

  @@index([orderId, status])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  paymentId         String               @db.Uuid
  providerReference String?
  status            PaymentAttemptStatus @default(PENDING)
  errorCode         String?
  errorMessage      String?
  idempotencyKey    String               @unique
  createdAt         DateTime             @default(now())
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  amount            Decimal      @db.Decimal(19, 4)
  currency          String       @db.VarChar(3)
  status            RefundStatus @default(PENDING)
  reason            String?
  providerReference String?      @unique
  idempotencyKey    String       @unique
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  currencyRef       Currency     @relation(fields: [currency], references: [code])

  @@index([paymentId, status])
  @@map("refunds")
}

model PaymentReconciliation {
  id           String    @id @default(uuid()) @db.Uuid
  provider     String
  externalId   String
  internalId   String?
  amount       Decimal   @db.Decimal(19, 4)
  currency     String    @db.VarChar(3)
  matched      Boolean   @default(false)
  difference   Decimal?  @db.Decimal(19, 4)
  reconciledAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([matched, createdAt])
  @@map("payment_reconciliations")
}

model Dispute {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @db.Uuid
  paymentId  String?           @db.Uuid
  userId     String            @db.Uuid
  reason     String
  status     DisputeStatus     @default(OPEN)
  resolution String?
  amount     Decimal?          @db.Decimal(19, 4)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment    Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  evidence   DisputeEvidence[]

  @@index([orderId, status])
  @@map("disputes")
}

model DisputeEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @db.Uuid
  storageKey String
  note       String?
  createdAt  DateTime @default(now())
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_evidence")
}

// ============================================================
// 12. ACCOUNTING - DOUBLE ENTRY
// ============================================================
model LedgerAccount {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  type      AccountType
  currency  String        @db.VarChar(3)
  sellerId  String?       @db.Uuid
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  lines     JournalLine[]

  @@index([sellerId, currency])
  @@map("ledger_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid()) @db.Uuid
  entryNumber   String        @unique
  description   String?
  referenceType String?
  referenceId   String?
  status        JournalStatus @default(DRAFT)
  currency      String        @db.VarChar(3)
  postedAt      DateTime?
  reversedById  String?       @unique @db.Uuid
  createdAt     DateTime      @default(now())
  lines         JournalLine[]
  reversedBy    JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reverses      JournalEntry? @relation("JournalReversal")

  @@index([referenceType, referenceId])
  @@index([status, createdAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(uuid()) @db.Uuid
  journalEntryId String        @db.Uuid
  accountId      String        @db.Uuid
  debit          Decimal       @default(0) @db.Decimal(19, 4)
  credit         Decimal       @default(0) @db.Decimal(19, 4)
  description    String?
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("journal_lines")
}

model SellerLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  sellerId       String          @db.Uuid
  vendorOrderId  String?         @db.Uuid
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(19, 4)
  currency       String          @db.VarChar(3)
  reference      String?
  idempotencyKey String          @unique
  description    String?
  createdAt      DateTime        @default(now())
  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  vendorOrder    VendorOrder?    @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)

  @@index([sellerId, currency, createdAt])
  @@map("seller_ledger_entries")
}

model CommissionRule {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  percentage   Decimal                 @db.Decimal(7, 4)
  fixedFee     Decimal                 @default(0) @db.Decimal(19, 4)
  currency     String?                 @db.VarChar(3)
  sellerId     String?                 @db.Uuid
  categoryId   String?                 @db.Uuid
  isActive     Boolean                 @default(true)
  validFrom    DateTime                @default(now())
  validUntil   DateTime?
  transactions CommissionTransaction[]

  @@index([isActive, validFrom])
  @@map("commission_rules")
}

model CommissionTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  vendorOrderId String          @db.Uuid
  sellerId      String          @db.Uuid
  ruleId        String?         @db.Uuid
  amount        Decimal         @db.Decimal(19, 4)
  currency      String          @db.VarChar(3)
  createdAt     DateTime        @default(now())
  vendorOrder   VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  seller        Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  rule          CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@map("commission_transactions")
}

model PayoutMethod {
  id           String   @id @default(uuid()) @db.Uuid
  sellerId     String   @db.Uuid
  userId       String   @db.Uuid
  provider     String
  accountToken String
  currency     String   @db.VarChar(3)
  isDefault    Boolean  @default(false)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts      Payout[]

  @@index([sellerId, isDefault])
  @@map("payout_methods")
}

model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  sellerId       String       @db.Uuid
  payoutMethodId String       @db.Uuid
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @db.VarChar(3)
  status         PayoutStatus @default(PENDING)
  providerRef    String?
  idempotencyKey String       @unique
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?
  seller         Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payoutMethod   PayoutMethod @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)

  @@index([sellerId, status, requestedAt])
  @@map("payouts")
}

// ============================================================
// 13. TAXES & CUSTOMS
// ============================================================
model TaxRegion {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  countryCode String    @db.VarChar(2)
  stateCode   String?
  isActive    Boolean   @default(true)
  country     Country   @relation(fields: [countryCode], references: [code])
  rates       TaxRate[]

  @@index([countryCode, stateCode])
  @@map("tax_regions")
}

model TaxRate {
  id         String    @id @default(uuid()) @db.Uuid
  regionId   String    @db.Uuid
  name       String
  taxType    TaxType
  percentage Decimal   @db.Decimal(7, 4)
  validFrom  DateTime
  validUntil DateTime?
  isActive   Boolean   @default(true)
  region     TaxRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@index([regionId, isActive, validFrom])
  @@map("tax_rates")
}

model TaxLine {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  orderItemId String?    @db.Uuid
  name        String
  taxType     TaxType
  rate        Decimal    @db.Decimal(7, 4)
  taxableBase Decimal    @db.Decimal(19, 4)
  amount      Decimal    @db.Decimal(19, 4)
  currency    String     @db.VarChar(3)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("tax_lines")
}

model CustomsDeclaration {
  id                String                   @id @default(uuid()) @db.Uuid
  shipmentId        String                   @db.Uuid
  declarationNumber String?
  incoterm          String?
  customsValue      Decimal                  @db.Decimal(19, 4)
  currency          String                   @db.VarChar(3)
  duties            Decimal                  @default(0) @db.Decimal(19, 4)
  taxes             Decimal                  @default(0) @db.Decimal(19, 4)
  status            String                   @default("PENDING")
  documentKey       String?
  createdAt         DateTime                 @default(now())
  shipment          Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items             CustomsDeclarationItem[]

  @@map("customs_declarations")
}

model CustomsDeclarationItem {
  id            String             @id @default(uuid()) @db.Uuid
  declarationId String             @db.Uuid
  orderItemId   String             @db.Uuid
  hsCode        String
  originCountry String
  quantity      Int
  customsValue  Decimal            @db.Decimal(19, 4)
  declaration   CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  orderItem     OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@map("customs_declaration_items")
}

// ============================================================
// 14. SHIPPING & LOGISTICS
// ============================================================
model ShippingCarrier {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  code      String            @unique
  website   String?
  isActive  Boolean           @default(true)
  services  ShippingService[]
  shipments Shipment[]

  @@map("shipping_carriers")
}

model ShippingService {
  id        String          @id @default(uuid()) @db.Uuid
  carrierId String          @db.Uuid
  name      String
  code      String
  isActive  Boolean         @default(true)
  carrier   ShippingCarrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  shipments Shipment[]

  @@unique([carrierId, code])
  @@map("shipping_services")
}

model ShippingZone {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  countries String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id          String       @id @default(uuid()) @db.Uuid
  zoneId      String       @db.Uuid
  serviceCode String
  currency    String       @db.VarChar(3)
  baseCost    Decimal      @db.Decimal(19, 4)
  perKgCost   Decimal      @default(0) @db.Decimal(19, 4)
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  currencyRef Currency     @relation(fields: [currency], references: [code])

  @@index([zoneId])
  @@map("shipping_rates")
}

model Shipment {
  id                  String                  @id @default(uuid()) @db.Uuid
  vendorOrderId       String                  @db.Uuid
  carrierId           String?                 @db.Uuid
  serviceId           String?                 @db.Uuid
  trackingNumber      String?
  status              ShipmentStatus          @default(PENDING)
  shippingCost        Decimal                 @default(0) @db.Decimal(19, 4)
  currency            String                  @db.VarChar(3)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  vendorOrder         VendorOrder             @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  carrier             ShippingCarrier?        @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  service             ShippingService?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  items               ShipmentItem[]
  events              ShipmentTrackingEvent[]
  packages            Package[]
  customsDeclarations CustomsDeclaration[]

  @@index([vendorOrderId, status])
  @@index([trackingNumber])
  @@map("shipments")
}

model Package {
  id             String        @id @default(uuid()) @db.Uuid
  shipmentId     String        @db.Uuid
  trackingNumber String?
  weight         Decimal?      @db.Decimal(12, 3)
  length         Decimal?      @db.Decimal(12, 3)
  width          Decimal?      @db.Decimal(12, 3)
  height         Decimal?      @db.Decimal(12, 3)
  dimensionUnit  String?
  weightUnit     String?
  labelKey       String?
  createdAt      DateTime      @default(now())
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items          PackageItem[]

  @@map("packages")
}

model PackageItem {
  id          String    @id @default(uuid()) @db.Uuid
  packageId   String    @db.Uuid
  orderItemId String    @db.Uuid
  quantity    Int
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@map("package_items")
}

model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @db.Uuid
  orderItemId String    @db.Uuid
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@map("shipment_items")
}

model ShipmentTrackingEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  status      ShipmentStatus
  description String?
  location    String?
  occurredAt  DateTime
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, occurredAt])
  @@map("shipment_tracking_events")
}

// ============================================================
// 15. RETURNS
// ============================================================
model ReturnRequest {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  status      ReturnStatus @default(REQUESTED)
  reason      String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items       ReturnItem[]

  @@index([orderId, status])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Uuid
  returnRequestId String        @db.Uuid
  orderItemId     String        @db.Uuid
  quantity        Int
  refundAmount    Decimal       @db.Decimal(19, 4)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("return_items")
}

// ============================================================
// 16. PROMOTIONS, COUPONS & LOYALTY
// ============================================================
model Promotion {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean             @default(true)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime            @default(now())
  coupons     Coupon[]
  products    PromotionProduct[]
  categories  PromotionCategory[]
  sellers     PromotionSeller[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Coupon {
  id             String             @id @default(uuid()) @db.Uuid
  promotionId    String             @db.Uuid
  code           String             @unique
  discountType   DiscountType
  discountValue  Decimal            @db.Decimal(19, 4)
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int                @default(0)
  status         CouponStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  promotion      Promotion          @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  redemptions    CouponRedemption[]

  @@index([promotionId])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String   @db.Uuid
  amount    Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model PromotionProduct {
  promotionId String    @db.Uuid
  productId   String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String    @db.Uuid
  categoryId  String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model PromotionSeller {
  promotionId String    @db.Uuid
  sellerId    String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([promotionId, sellerId])
  @@map("promotion_sellers")
}

model LoyaltyProgram {
  id            String               @id @default(uuid()) @db.Uuid
  name          String
  isActive      Boolean              @default(true)
  pointsPerUnit Decimal              @default(1) @db.Decimal(10, 4)
  createdAt     DateTime             @default(now())
  transactions  LoyaltyTransaction[]

  @@map("loyalty_programs")
}

model LoyaltyTransaction {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  programId   String         @db.Uuid
  points      Int
  description String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  program     LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("loyalty_transactions")
}

model GiftCard {
  id           String                @id @default(uuid()) @db.Uuid
  codeHash     String                @unique
  currency     String                @db.VarChar(3)
  balance      Decimal               @db.Decimal(19, 4)
  expiresAt    DateTime?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  transactions GiftCardTransaction[]

  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  giftCardId String   @db.Uuid
  orderId    String?  @db.Uuid
  amount     Decimal  @db.Decimal(19, 4)
  createdAt  DateTime @default(now())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@map("gift_card_transactions")
}

// ============================================================
// 17. REVIEWS & PRODUCT QUESTIONS
// ============================================================
model Review {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  productId   String        @db.Uuid
  orderItemId String?       @db.Uuid
  rating      Int
  title       String?
  comment     String?       @db.Text
  isVerified  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  media       ReviewMedia[]

  @@unique([userId, productId])
  @@index([productId, rating, createdAt])
  @@map("reviews")
}

model ReviewMedia {
  id         String @id @default(uuid()) @db.Uuid
  reviewId   String @db.Uuid
  storageKey String
  mediaType  String @default("IMAGE")
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_media")
}

model StoreReview {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sellerId  String   @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([userId, sellerId])
  @@index([sellerId, rating])
  @@map("store_reviews")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Recommendation {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  productId String  @db.Uuid
  score     Float
  reason    String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, score])
  @@map("recommendations")
}

model ProductQuestion {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @db.Uuid
  userId    String          @db.Uuid
  question  String          @db.Text
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers   ProductAnswer[]

  @@index([productId, createdAt])
  @@map("product_questions")
}

model ProductAnswer {
  id         String          @id @default(uuid()) @db.Uuid
  questionId String          @db.Uuid
  userId     String          @db.Uuid
  answer     String          @db.Text
  createdAt  DateTime        @default(now())
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("product_answers")
}

// ============================================================
// 18. SUPPORT & COMMUNICATION
// ============================================================
model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  subject   String
  status    SupportTicketStatus @default(OPEN)
  priority  String              @default("NORMAL")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  senderId  String        @db.Uuid
  body      String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model StoreConversation {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @db.Uuid
  sellerId   String         @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   User           @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  seller     Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages   StoreMessage[]

  @@unique([customerId, sellerId])
  @@index([sellerId, updatedAt])
  @@map("store_conversations")
}

model StoreMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  senderId       String            @db.Uuid
  body           String            @db.Text
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("store_messages")
}

// ============================================================
// 19. INVOICES & CREDIT NOTES
// ============================================================
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  orderId       String        @db.Uuid
  currency      String        @db.VarChar(3)
  subtotal      Decimal       @db.Decimal(19, 4)
  taxTotal      Decimal       @db.Decimal(19, 4)
  total         Decimal       @db.Decimal(19, 4)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  creditNotes   CreditNote[]

  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(19, 4)
  total       Decimal @db.Decimal(19, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("invoice_items")
}

model CreditNote {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @db.Uuid
  noteNumber String   @unique
  amount     Decimal  @db.Decimal(19, 4)
  reason     String?
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("credit_notes")
}

// ============================================================
// 20. PROPERTY DOMAIN - LOGICALLY SEPARATE
// ============================================================
model Property {
  id           String                @id @default(uuid()) @db.Uuid
  title        String                @db.VarChar(180)
  description  String?               @db.Text
  price        Decimal               @db.Decimal(19, 4)
  currency     String                @db.VarChar(3)
  location     String
  countryCode  String?               @db.VarChar(2)
  city         String?
  status       PropertyStatus        @default(AVAILABLE)
  type         PropertyType          @default(APARTMENT)
  attributes   Json                  @default("{}")
  isPublished  Boolean               @default(false)
  ownerId      String                @db.Uuid
  storeId      String                @db.Uuid
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  owner        User                  @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  media        PropertyMedia[]
  translations PropertyTranslation[]
  wishlists    PropertyWishlist[]
  bookings     BookingRequest[]

  @@index([countryCode, status, city])
  @@index([storeId, createdAt])
  @@map("properties")
}

model PropertyMedia {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  storageKey String
  mediaType  String   @default("IMAGE")
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_media")
}

model PropertyTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  language    String
  title       String
  description String?  @db.Text
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, language])
  @@map("property_translations")
}

model PropertyWishlist {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("property_wishlists")
}

model BookingRequest {
  id             String               @id @default(uuid()) @db.Uuid
  idempotencyKey String               @unique
  userId         String               @db.Uuid
  propertyId     String               @db.Uuid
  quotedPrice    Decimal              @db.Decimal(19, 4)
  currency       String               @db.VarChar(3)
  feeAmount      Decimal              @default(0) @db.Decimal(19, 4)
  status         BookingRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  property       Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([propertyId, status])
  @@map("booking_requests")
}

// ============================================================
// 21. NOTIFICATIONS, AUDIT & CMS
// ============================================================
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  message   String    @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model SitePage {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique
  title        String
  content      String                @db.Text
  isActive     Boolean               @default(true)
  updatedAt    DateTime              @updatedAt
  translations SitePageTranslation[]

  @@map("site_pages")
}

model SitePageTranslation {
  id       String   @id @default(uuid()) @db.Uuid
  pageId   String   @db.Uuid
  language String
  title    String
  content  String   @db.Text
  page     SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, language])
  @@map("site_page_translations")
}

model MarketplaceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("marketplace_settings")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ============================================================
// 22. WEBHOOKS & INTEGRATIONS
// ============================================================
model Webhook {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  url        String
  secret     String
  events     String[]
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id            String                @id @default(uuid()) @db.Uuid
  webhookId     String                @db.Uuid
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  responseCode  Int?
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  webhook       Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model Integration {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  provider  String
  config    Json?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integrations")
}

// ============================================================
// 23. OUTBOX & BACKGROUND JOBS
// ============================================================
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model BackgroundJob {
  id          String       @id @default(uuid()) @db.Uuid
  queue       String
  jobType     String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(5)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([queue, status, availableAt])
  @@map("background_jobs")
}

// ============================================================
// 24. REPORTS, ANALYTICS & SEARCH
// ============================================================
model Report {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("reports")
}

model DailySiteVisit {
  day   DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([day, path])
  @@map("daily_site_visits")
}

model SearchSynonym {
  id        String   @id @default(uuid()) @db.Uuid
  language  String
  term      String
  synonyms  String[]
  createdAt DateTime @default(now())

  @@unique([language, term])
  @@map("search_synonyms")
}

model NewsletterSubscriber {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  confirmationTokenHash String?   @unique
  unsubscribeTokenHash  String?   @unique
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([confirmedAt, unsubscribedAt])
  @@map("newsletter_subscribers")
}
