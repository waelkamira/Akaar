datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  GUEST
  /// Buyer role; the CUSTOMER identifier is retained for application compatibility.
  CUSTOMER
  /// Vendor (broker or agent) role; the SELLER identifier is retained for application compatibility.
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
}

enum PropertyType {
  APARTMENT
  VILLA
  LAND
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String     @id @default(uuid())
  userName      String?
  email         String     @unique
  googleId      String?    @unique
  password      String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  roleId        String?
  userImage     String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products        Product[]
  reviews         Review[]
  favorites       Favorite[]
  orders          Order[]
  payments        Payment[]
  notifications   Notification[]
  reports         Report[]
  recommendations Recommendation[]
  roleAssignment  Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  seller          Seller?
  store           Store?                @relation("VendorStore")
  properties       Property[]           @relation("PropertyOwner")
  propertyWishlist PropertyWishlist[]
  bookingRequests  BookingRequest[]
  cart            Cart?
  passwordResets  PasswordResetToken[]

  @@index([userName])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([roleId])
  @@map("users")
}

model Seller {
  id                     String       @id @default(uuid())
  userId                 String       @unique
  storeName              String
  slug                   String       @unique
  description            String?
  logo                   String?
  contactName            String?
  contactEmail           String?
  phoneNumber            String?
  residence              String?
  latitude               Float?
  longitude              Float?
  businessType           String?
  sellingCategories      String?
  intendedProducts       String?
  identityDocumentFileId String?
  facebookUrl            String?
  youtubeUrl             String?
  twitterUrl             String?
  status                 SellerStatus @default(PENDING)
  isVerified             Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  vendorOrders VendorOrder[]

  @@index([status])
  @@index([isVerified])
  @@index([storeName])
  @@map("sellers")
}

model Store {
  id          String   @id @default(uuid())
  vendorId    String   @unique
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor     User       @relation("VendorStore", fields: [vendorId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([name])
  @@map("stores")
}

model GuestSession {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart?

  @@index([expiresAt])
  @@map("guest_sessions")
}

model Product {
  id             String                @id @default(uuid())
  title          String
  userId         String
  sellerId       String?
  userImage      String?
  userName       String?
  categoryId     Int                   @default(1)
  categoryName   String
  images         String[]
  /// Storefront unit price. Application code treats this as `price`.
  basePrice      Int?
  adCategory     String?
  city           String?
  town           String?
  phoneNumber    String?
  lng            Float?
  lat            Float?
  link           String?               @default("")
  details        Json?
  description    String?
  /// On-hand quantity. Application code treats this as `stock`.
  stockQuantity  Int?                  @default(1)
  salesCount     Int                   @default(0)
  isActive       Boolean               @default(true)
  approvalStatus ProductApprovalStatus @default(APPROVED)
  isDeleted      Boolean               @default(false)
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller          Seller?               @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  category        Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  favorites       Favorite[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  recommendations Recommendation[]
  priceHistory    ProductPriceHistory[]
  discounts       Discount[]
  translations    ProductTranslation[]
  media           ProductImage[]

  @@index([userId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([basePrice])
  @@index([salesCount])
  @@index([isActive])
  @@index([approvalStatus, isActive, createdAt])
  @@index([approvalStatus, isDeleted, createdAt])
  @@index([sellerId, approvalStatus, isActive, createdAt])
  @@index([title], map: "products_title_btree_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@index([categoryName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_category_name_trgm_idx")
  @@index([userName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_user_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@index([categoryId, basePrice])
  @@index([categoryId, createdAt])
  @@index([city])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([isDeleted, isActive, createdAt])
  @@index([isDeleted, isActive, basePrice])
  @@index([isDeleted, isActive, salesCount])
  @@index([categoryId, isDeleted, isActive])
  @@map("products")
}

model Property {
  id          String         @id @default(uuid())
  title       String         @db.VarChar(180)
  description String?        @db.Text
  price       Decimal        @db.Decimal(16, 2)
  currency    String         @default("USD") @db.VarChar(3)
  location    String         @db.VarChar(240)
  country     String?        @db.VarChar(100)
  city        String?        @db.VarChar(120)
  images      String[]       @default([])
  status      PropertyStatus @default(AVAILABLE)
  type        PropertyType   @default(APARTMENT)
  attributes  Json           @default("{}")
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String
  storeId     String

  owner     User               @relation("PropertyOwner", fields: [userId], references: [id], onDelete: Cascade)
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  wishlists PropertyWishlist[]
  bookingRequests BookingRequest[]

  @@index([status, createdAt, id])
  @@index([type, status, createdAt, id])
  @@index([country, status, city, createdAt])
  @@index([city, status, createdAt])
  @@index([price])
  @@index([storeId, createdAt])
  @@index([userId, status, createdAt])
  @@index([isPublished, status, createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_description_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_location_trgm_idx")
  @@index([attributes(ops: raw("jsonb_path_ops"))], type: Gin, map: "properties_attributes_gin_idx")
  @@map("properties")
}

model PropertyWishlist {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("property_wishlist")
}

model BookingRequest {
  id             String               @id @default(uuid())
  idempotencyKey String               @unique
  userId         String
  propertyId     String
  quotedPrice    Decimal              @db.Decimal(16, 2)
  feeAmount      Decimal              @db.Decimal(10, 2)
  feeCurrency    String               @default("USD") @db.VarChar(3)
  status         BookingRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([propertyId, status, createdAt])
  @@map("booking_requests")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, isDeleted])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id    String @id @default(uuid())
  name  String @unique
  roles Role[]
}

model Category {
  id          Int      @id
  name        String
  slug        String   @unique
  description String?
  parentId    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([name])
  @@index([name])
  @@index([parentId])
  @@index([isActive])
}

model Country {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  cities    City[]
  suppliers Supplier[]

  @@index([name])
  @@index([code])
}

model City {
  id        String @id @default(uuid())
  name      String
  countryId String

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([name, countryId])
  @@index([name])
  @@index([countryId])
}

model Supplier {
  id        String  @id @default(uuid())
  name      String  @unique
  email     String  @unique
  phone     String?
  address   String?
  countryId String
  cityId    String?

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city    City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([email])
  @@index([countryId])
  @@index([cityId])
}

model ProductTranslation {
  id          String  @id @default(uuid())
  productId   String
  language    String
  title       String
  description String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([language])
  @@index([title])
  @@index([productId])
}

model ProductPriceHistory {
  id        String   @id @default(uuid())
  productId String
  price     Int
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, rating])
  @@index([userId])
}

model Cart {
  id             String   @id @default(uuid())
  userId         String?  @unique
  guestSessionId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  discountId       String?
  shippingMethodId String?
  customerName     String?
  phoneNumber      String?
  shippingCity     String?
  shippingAddress  String?
  totalPrice       Int
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments       Payment[]
  discount       Discount?       @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shipping       Shipping[]
  returns        Return[]
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  vendorOrders   VendorOrder[]

  @@index([status])
  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([discountId])
  @@index([shippingMethodId])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  vendorOrderId String?
  quantity      Int
  unitPrice     Int
  totalPrice    Int

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([vendorOrderId])
}

model VendorOrder {
  id             String            @id @default(uuid())
  orderId        String
  sellerId       String
  status         VendorOrderStatus @default(PENDING)
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items  OrderItem[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId])
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  userId    String
  amount    Int
  method    String
  status    PaymentStatus
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([orderId])
  @@index([userId])
  @@index([status, paidAt])
}

model Discount {
  id         String   @id @default(uuid())
  productId  String
  code       String   @unique
  percentage Int
  validFrom  DateTime
  validTo    DateTime

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([code])
  @@index([productId])
  @@index([validFrom, validTo])
}

model Shipping {
  id             String   @id @default(uuid())
  orderId        String
  status         String
  trackingNumber String?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([orderId])
  @@index([trackingNumber])
}

model Return {
  id           String   @id @default(uuid())
  orderId      String
  reason       String
  status       String
  refundAmount Float?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model MarketplaceSetting {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("marketplace_settings")
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Recommendation {
  id        String  @id @default(uuid())
  userId    String
  productId String
  score     Float
  reason    String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, score])
  @@index([productId])
}

model ShippingMethod {
  id     String  @id @default(uuid())
  name   String
  cost   Float
  orders Order[]

  @@index([name])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}
